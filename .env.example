# Required — scoring, resume, and cover letter generation all call the Anthropic API.
ANTHROPIC_API_KEY=

# Required to email yourself the digest. Use a Gmail App Password, not your
# account password: https://myaccount.google.com/apppasswords
EMAIL_FROM=
EMAIL_APP_PASSWORD=

# Optional — where your company/filter config lives.
# Defaults to config/portals.yml in this repo.
PORTALS_PATH=

# Optional — use a specific interpreter for run_pipeline.sh (venv/conda).
# Defaults to python3 on PATH.
PYTHON=

# Optional — Wellfound scraping. Leave blank to skip it.
WELLFOUND_EMAIL=
WELLFOUND_PASSWORD=

# Optional — only if you also use career-ops (github.com/santifer/career-ops).
# Path to its data/applications.md, so roles you've already applied to are
# excluded from the digest.
CAREER_OPS_TRACKER=
